{
  "name": "nimbus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nimbus, a practice trainer for the AWS Certified Cloud Practitioner exam",
  "scripts": {
    "import": "node tools/import.mjs",
    "verify": "node tools/verify.mjs",
    "verify:negative": "node tools/verify-negative.mjs",
    "dev": "hugo server --disableFastRender",
    "build": "hugo --minify --gc --cleanDestinationDir",
    "test": "node tools/verify.mjs && node tools/verify-negative.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
